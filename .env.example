# ── Required ──────────────────────────────────────────────────────────────────
# Signs Payload's auth cookies. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Where the site is served from. Used for preview links and CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guards the draft-preview endpoint. Generate with: openssl rand -base64 24
PREVIEW_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Local file (default) — back up by copying data/site.db
DATABASE_URI=file:./data/site.db
# Or a hosted libSQL/Turso database for serverless production:
# DATABASE_URI=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# ── Media storage ─────────────────────────────────────────────────────────────
# Leave empty for local disk (development only — files in /public do not survive
# a redeploy on most hosts). Set all four to switch every upload to S3-compatible
# object storage: Cloudflare R2, Backblaze B2, AWS S3.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
# Public base URL of the bucket, used to allow the host in next/image.
S3_PUBLIC_URL=

# ── First run ─────────────────────────────────────────────────────────────────
# Used once by `npm run seed` to create the owner account.
SEED_EMAIL=you@example.com
SEED_PASSWORD=

# ── GitHub Pages preview (optional; only read by scripts/build-static.mjs) ────
# Empty for a custom domain. `/personal-site` when serving from the bare
# GitHub project URL, because everything then lives one directory down.
# Baked into the client bundles at build time, so changing it needs a rebuild.
NEXT_PUBLIC_BASE_PATH=
# Written to out/CNAME when set. Leave empty until the DNS record exists.
PAGES_CNAME=
