# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and holds no secrets. It was
# swallowed by the wildcard above and had never actually been committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload
/data
/media

# Static export for the GitHub Pages preview. Build artefacts, and the copy of
# the upload directory the export needs — both regenerated by `npm run build:static`.
/out
/.static-build
/public/media
/.static-build-hidden
